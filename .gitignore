# Společná pravidla. Každá část má vlastní .gitignore (mobil/, mobil/android/, backend/).

# Node
node_modules/
npm-debug.log*
*.log

# Build výstupy
dist/
www/
.angular/
coverage/
*.tsbuildinfo

# Lokální konfigurace
.env
.env.*
*.local

# Android artefakty, ať skončí kdekoliv
*.apk
*.aab
*.hprof

# Podpisové klíče — nikdy do repozitáře
*.jks
*.keystore
keystore.properties

# Editory a OS
.idea/
.vscode/
*.iml
.DS_Store

# Fotky skutečných tiketů pro ladění čtení — čárový kód nese číslo klubové karty
tikety/
