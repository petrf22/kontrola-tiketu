<?xml version="1.0" encoding="utf-8"?>
<!--
    Tvrdé požadavky na soukromí ze zadání jsou akceptační kritéria, ne doporučení.
    Většina z nich je vidět právě tady a dá se ověřit v sestavené aplikaci bez důvěry v kód.

    Nepřidávej sem INTERNET ani jiné síťové oprávnění. Absence síťové permission je
    ověřitelná záruka, že aplikace nemůže nic vynést — je to funkce, ne opomenutí.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Jediné oprávnění aplikace. Snímky se zpracovávají ve streamu a nikam se neukládají,
        takže nic dalšího potřeba není.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Capacitor i některé knihovny si INTERNET přidávají samy. Tenhle řádek ho ze sloučeného
        manifestu odstraní, ať se do sestavené aplikace nedostane oklikou přes závislost.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!--
        SQLite plugin si přitahuje biometrii kvůli volitelnému odemykání databáze otiskem.
        Tuhle možnost nepoužíváme — klíč drží Android Keystore bez součinnosti uživatele —
        takže oprávnění ven. Zadání připouští jedinou permission, a tou je kamera.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            FileProvider zůstává kvůli importu JSON s výsledky. Sdílí se jen dovnitř,
            exported je false a grantUriPermissions platí pro jednorázový přístup k
            vybranému souboru.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
