# Document root backendu. Servíruje se odsud jen /v1/*.json a robots.txt a jediné PHP — spouštěč
# cronu pod tajným jménem. Soubory v v1/ vyrábí `tik` z cronu.
#
# Každý blok je v <IfModule>, aby chybějící modul na sdíleném hostingu neshodil celý web
# chybou 500. Že hlavičky opravdu chodí, se ověří po nasazení (docs/backend.md).

Options -Indexes
DirectoryIndex disabled

# Dočasné soubory publikace (.2026.json.xxxx.tmp) ani nic jiného s tečkou na začátku ven nesmí.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(robots\.txt|v1/[a-z0-9-]+\.json)$ - [L]
    # Cron hostingu umí jen zavolat URL (docs/backend.md, „Gigaserver“). Soubor s tajným jménem
    # leží jen na serveru a odkazuje do bin/cron.php mimo docroot. Jméno, které neexistuje,
    # dostane 403 stejně jako všechno ostatní.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^cron/[0-9a-f]{32}\.php$ - [L]
    RewriteRule ^ - [F]
</IfModule>

# Schválně text/plain, ne application/json: u JSON typu Capacitor v aplikaci odpověď sám
# rozparsuje a nevydá bajty, ze kterých se ověřuje hash z manifestu. Hlídá HtaccessTest.
<IfModule mod_mime.c>
    AddType "text/plain; charset=utf-8" .json
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    # Žádné cookies. Kdyby je hosting přidával sám, ať se k aplikaci nedostanou.
    Header always unset Set-Cookie

    <FilesMatch "\.json$">
        # Klient se ptá vždy celým dotazem bez podmíněných hlaviček a nové pozná podle hashe
        # v manifestu. Mezipaměť po cestě by mu jen podstrkovala staré soubory.
        Header set Cache-Control "no-cache"
        # Gigaserver přes mod_expires přidává Expires o 30 dní dopředu. Cache-Control má sice
        # přednost, ale ať po cestě nic nesvádí k podržení starého manifestu.
        Header unset Expires
        # Veřejná data; potřeba pro vývoj aplikace v prohlížeči.
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
