<?xml version="1.0" encoding="utf-8"?>
<!--
    Tvrdé požadavky na soukromí ze zadání jsou akceptační kritéria, ne doporučení.
    Většina z nich je vidět právě tady a dá se ověřit v sestavené aplikaci bez důvěry v kód.

    INTERNET tu je kvůli stažení výsledků z backendu (docs/backend.md). Zadání to připouští jen
    s tvrdým pravidlem: stahují se vždy všechny tahy, nikdy dotaz vázaný na tiket. Záruku, kterou
    dřív dávala absence oprávnění, teď drží tři věci a všechny hlídá app/test/soukromi.test.ts:

    1. network_security_config pustí TLS jedině na server výsledků,
    2. Googlí vrstva pro odesílání záznamů z ML Kitu je ze sloučeného manifestu odstraněná,
    3. na síť sahá jediný modul aplikace a ten o tiketech neví (app/test/sit.test.ts).

    Žádné další síťové oprávnění sem nepatří.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Snímky se zpracovávají na zařízení a nikam se neukládají. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Jen pro stažení výsledků; kam smí spojení vést, určuje network_security_config. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Stav sítě aplikace znát nepotřebuje — když je offline, stažení prostě selže. Knihovny
        si tyhle oprávnění přidávají samy, tak se ze sloučeného manifestu odstraňují.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!--
        SQLite plugin si přitahuje biometrii kvůli volitelnému odemykání databáze otiskem.
        Tuhle možnost nepoužíváme — klíč drží Android Keystore bez součinnosti uživatele —
        takže oprávnění ven. Aplikace žádá jen o kameru a o internet kvůli výsledkům.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Googlí přenosová vrstva pro odesílání záznamů (Firelog), kterou vtahuje ML Kit.
            Dokud aplikace neměla INTERNET, nemohla nic odeslat; teď by mohla. Proto ven:
            registrace backendu CCT (tím se posílá do Googlu) i obě plánovací komponenty.
            Kdyby je něco přesto spustilo, TLS spojení mimo server výsledků nepustí
            network_security_config. Viz docs/vydani.md, „Past: v manifestu je Googlí datatransport“.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />

        <!--
            FileProvider zůstává kvůli importu JSON s výsledky. Sdílí se jen dovnitř,
            exported je false a grantUriPermissions platí pro jednorázový přístup k
            vybranému souboru.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
